
def replace_value(values, index, new_value):
    values[index] = new_value


def find_first(values, target):
    for i in range(len(values)):
        if values[i] == target:
            return i
    return -1


def summarize(values):
    stats_record = (min(values), max(values), sum(values))
    return stats_record


days = int(input("Enter the number of days: "))

original = []

for i in range(days):
    data = int(input("Enter data use in megabytes: "))
    original.append(data)

updated = original[:]

index = int(input("Enter the index to correct: "))
new_value = int(input("Enter the new data use: "))

replace_value(updated, index, new_value)

target = int(input("Enter the data use to search for: "))

first_index = find_first(updated, target)
count_values = updated.count(target)

minimum, maximum, total = summarize(updated)

sorted_values = sorted(updated)

print(f"Original: {original}")
print(f"Updated: {updated}")
print(f"Sorted: {sorted_values}")
print(f"Minimum data use: {minimum} MB")
print(f"Maximum data use: {maximum} MB")
print(f"Total data use: {total} MB")

if first_index == -1:
    print("Target not found")
else:
    print(f"First matching index: {first_index}")

print(f"Matching values: {count_values}")   
